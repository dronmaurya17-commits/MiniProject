<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen text-white p-10 bg-zinc-900">

        <a class="bg-red-500 rounded-lg px-3 py-2 hover:bg-red-700 hover:shadow-lg shadow-red-400" href="/logout">Logout</a>
        <h3 class="mt-4 text-3xl mb-2">Hello, <%= post.user.name %> </h3>
        <h4 class="mb-5">You can Edit your POST</h4>

        <form method="post" action="/update/<%= post._id %>">
            <textarea class="w-1/3 p-3 block  resize-none bg-zinc-700 border-2 border-zinc-400 rounded-md" placeholder="Bring the best of your thoughts here!!" name="content"><%= post.content %></textarea>
            <input type="submit" value="Update Post" class="block text-centre mt-2 px-3 rounded-2xl bg-yellow-600 hover:bg-yellow-700 hover:shadow shadow-yellow-300 hover:cursor-pointer">
        </form>


    </div>


</body>
</html>