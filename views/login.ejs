<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="text-white">
    <div class="w-full min-h-screen bg-zinc-900 p-10">
        <h3 class="text-3xl mb-7">Login Account</h3>
        <form action="/login" method="post" class="p-25">
            <input class="flex flex-col mt-6  px-1 py-2  hover:shadow-lg shadow-neutral-50 rounded-xl border-zinc-400 border-t-2 border-l-4" type="email" name="email" placeholder="email">
            <input class="flex flex-col mt-6  px-1 py-2  hover:shadow-lg shadow-neutral-50 rounded-xl border-zinc-400 border-t-2 border-l-4" type="password" name="password" placeholder="password">
            <input class="bg-blue-600 hover:bg-blue-800 hover:shadow shadow-blue-300 hover:cursor-pointer rounded-3xl mt-8 px-2 text-center" type="submit" value="Login Account">
        </form>
    </div>
</body>
</html>