<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen text-white p-10 bg-zinc-900">

        <a class="bg-red-500 rounded-lg px-3 py-2 hover:bg-red-700 hover:shadow-lg shadow-red-400" href="/logout">Logout</a>
        <h3 class="mt-4 text-3xl mb-2">Hello, <%= user.name %> </h3>
        <h4 class="mb-5">You can create a POST</h4>

        <form method="post" action="/post">
            <textarea class="w-1/3 p-3 block  resize-none bg-zinc-700 border-2 border-zinc-400 rounded-md" placeholder="Bring the best of your thoughts here!!" name="content"></textarea>
            <input type="submit" value="Create new Post" class="block text-centre mt-2 px-3 rounded-2xl bg-blue-500 hover:bg-blue-700 hover:shadow shadow-blue-300 hover:cursor-pointer">
        </form>

        <div class="posts mt-20">
            <h3 class="text-xl">Your Posts.</h3>
            <div class="postcontainer mt-5">

               <% user.posts.forEach(function(post){ %>
                   <div class="post w-1/3 p-3 bg-zinc-700 rounded-md mb-2">
                    <h3 class="text-green-300 font-bold mb-2"> <%= user.username %> </h3>
                    <p class="text-orange-500 tracking-tight"> <%= post.content %> </p>
                    <small class="ml-80 mt-3"><%= post.likes.length %>Likes</small>
                    <div class="ml-82 btns flex mt-1 gap-4">
                        <a class="text-blue-200 hover:text-blue-500 hover:font-serif" href="/like/<%= post._id %>">
                            <%= post.likes.indexOf(user._id) === -1 ? "Like" : "UnLike" %>
                        </a>
                        <a class="text-yellow-600 hover:text-yellow-400 hover:underline" href="/edit/<%= post._id %>">Edit</a>
                    </div>
                </div>

               <% }) %>
            </div>

        </div>

    </div>


</body>
</html>