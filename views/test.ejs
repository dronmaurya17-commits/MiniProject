<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Test Multer</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="text-white">
    <div class="w-full min-h-screen bg-zinc-900 p-10">
        <h3 class="text-3xl mb-7">Upload File</h3>
        <form action="/upload" method="post" autocomplete="off" class="p-25" enctype="multipart/form-data">
            <input type="file" name="image" class="bg-zinc-400 px-1" >
            <input class="bg-blue-600 hover:bg-blue-800 hover:shadow shadow-blue-300 hover:cursor-pointer rounded-3xl mt-8 px-2 text-center" type="submit" value="Upload File">
        </form>
    </div>
</body>
</html>